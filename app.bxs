app = boxExpress()

// A single variadic app.use() call, registered in order — see the
// "Multiple middleware in one call" section on the Middleware page.
app.use(
    boxExpressJSON(),
    boxExpressUrlencoded(),
    boxExpressSession( { resave: false, saveUninitialized: false } ),
    boxExpressStatic( expandPath( "./public" ), { maxAge: 86400 } ),  // cache assets for 1 day
    boxExpressHelmet()
)
app.set( "views", expandPath( "./views" ) )

app.set( "reloadOnChange", true )
app.set("env", "development")

// Shared sidebar nav for every /docs/* page — see views/partials/_head.bxm.
// Set once on app.locals rather than passed to every render() call below —
// see the "app.locals / res.locals" section on the Views & Templates page.
app.locals.navGroups = [
    {
        label: "Getting Started",
        items: [
            { label: "Getting Started", href: "/docs/getting-started" },
            { label: "Configuration", href: "/docs/config" }
        ]
    },
    {
        label: "Core Concepts",
        items: [
            { label: "Routing", href: "/docs/routing" },
            { label: "Middleware", href: "/docs/middleware" },
            { label: "Request & Response", href: "/docs/request-response" },
            { label: "Views & Templates", href: "/docs/views" }
        ]
    },
    {
        label: "Features",
        items: [
            { label: "Sessions", href: "/docs/sessions" },
            { label: "Static Files & Uploads", href: "/docs/static-files" },
            { label: "Error Handling", href: "/docs/errors" }
        ]
    },
    {
        label: "Operations",
        items: [
            { label: "Process Lifecycle", href: "/docs/lifecycle" }
        ]
    }
]

app.get("/", ( req, res ) => {
    res.render( "home", { title: "Home", docsMode: false, currentPath: req.path } )
})

app.get( "/docs/getting-started", ( req, res ) => {
    res.render( "docs/getting-started", { title: "Getting Started", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/config", ( req, res ) => {
    res.render( "docs/config", { title: "Configuration", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/routing", ( req, res ) => {
    res.render( "docs/routing", { title: "Routing", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/middleware", ( req, res ) => {
    res.render( "docs/middleware", { title: "Middleware", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/request-response", ( req, res ) => {
    res.render( "docs/request-response", { title: "Request & Response", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/views", ( req, res ) => {
    res.render( "docs/views", { title: "Views & Templates", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/sessions", ( req, res ) => {
    res.render( "docs/sessions", { title: "Sessions", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/static-files", ( req, res ) => {
    res.render( "docs/static-files", { title: "Static Files & Uploads", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/errors", ( req, res ) => {
    res.render( "docs/errors", { title: "Error Handling", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/lifecycle", ( req, res ) => {
    res.render( "docs/lifecycle", { title: "Process Lifecycle", docsMode: true, currentPath: req.path } )
} )

app.get( "/upload", boxExpressCsrf(), ( req, res ) => {
    res.render( "upload", { title: "Upload Demo", docsMode: false, currentPath: req.path, csrfToken: req.csrfToken() } )
} )

app.post(
    "/upload",
    boxExpressRateLimit( { windowMs: 5 * 60000, max: 10 } ),
    boxExpressUpload( { dest: expandPath( "./uploads" ) } ),
    // After boxExpressUpload(), not before — this needs req.body._csrf,
    // which the multipart parser above is what populates it.
    boxExpressCsrf(),
    ( req, res ) => {
        res.render( "upload", {
            title: "Upload Demo",
            docsMode: false,
            currentPath: req.path,
            result: {
                note: req.body.note ?: "",
                files: req.files.file ?: []
            }
        } )
    }
)

// Themed 404 — must come after every real route, since it's an unconditional
// catch-all: whatever hasn't matched by the time dispatch reaches this falls
// through to it.
app.use( ( req, res ) => {
    res.status( 404 ).render( "error", {
        statusCode: 404,
        title: "Page Not Found",
        message: "The page you're looking for doesn't exist or has moved.",
        path: req.path,
        accent: "##2563eb",
        iconPath: "M11 17a6 6 0 1 0 0-12 6 6 0 0 0 0 12ZM21 21l-4.35-4.35"
    } )
} )

// Themed 500 — a 4-arg handler only runs when a route/middleware throws or
// calls next(err), same as the framework's own default error handler.
app.use( ( err, req, res, next ) => {
    var isDev = app.getSetting( "env" ) == "development"
    res.status( 500 ).render( "error", {
        statusCode: 500,
        title: "Something Went Wrong",
        message: isDev ? err.message : "An unexpected error occurred. Please try again.",
        path: "",
        accent: "##dc2626",
        iconPath: "M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"
    } )
} )

app.listen(3003, ( port ) => {
    println( "Server is running on port #port#" )
})
