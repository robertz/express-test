app = boxExpress()

// Liveness/readiness endpoints — registered before the middleware below so a
// probe doesn't create a session. See the Process Lifecycle page.
app.health()
app.metrics()    // Prometheus endpoint at /metrics — see the Observability page

// The Middleware page's live example: a webhook whose JSON body is only
// accepted if its X-Signature header is the HMAC-SHA256 of the exact bytes
// sent. Registered above the app-wide boxExpressJSON() below on purpose —
// whichever parser reaches a body first reads it, and that one wouldn't check.
webhookSecret = "demo-webhook-secret"
app.post( "/docs/middleware/demo/webhook",
    boxExpressJSON( { verify: ( req, res, bodyBytes ) => {
        var expected = lCase( hmac( bodyBytes, webhookSecret, "HmacSHA256" ) )
        var given = req.get( "X-Signature" ) ?: ""
        if ( !createObject( "java", "java.security.MessageDigest" ).isEqual( expected.getBytes( "UTF-8" ), given.getBytes( "UTF-8" ) ) ) {
            throw( "signature mismatch" )
        }
    } } ),
    ( req, res ) => res.json( { verified: true, event: req.body.event ?: "" } )
)

// The Middleware page's validation example. Its own boxExpressJSON() runs
// first; boxExpressValidate() reads req.body, it doesn't parse it.
app.post( "/docs/middleware/demo/signup",
    boxExpressJSON(),
    boxExpressValidate( {
        body: {
            email: { type: "email", required: true },
            name: { type: "string", required: true, trim: true, maxLength: 40 },
            age: { type: "integer", min: 18 },
            plan: { type: "string", oneOf: [ "free", "pro" ], default: "free" }
        },
        query: { notify: { type: "boolean", default: false } }
    } ),
    ( req, res ) => res.status( 201 ).json( req.valid )
)

// A single variadic app.use() call, registered in order — see the
// "Multiple middleware in one call" section on the Middleware page.
app.use(
    boxExpressJSON(),
    boxExpressUrlencoded(),
    boxExpressSession( { resave: false, saveUninitialized: false } ),
    boxExpressStatic( expandPath( "./public" ), { maxAge: 86400 } ),  // cache assets for 1 day
    boxExpressHelmet()
)
app.set( "views", expandPath( "./views" ) )
// Every res.render() below is wrapped in views/layouts/site.bxm — see
// "Layouts" on the Views & Templates page.
app.set( "view layout", "layouts/site" )
app.set( "requestId", true )    // X-Request-Id header, req.id, and the id in log lines
app.set( "log", "access" )      // one line per request once answered: status, duration, bytes

// Signs res.cookie( ..., { signed: true } ) — see "Signed cookies" on the
// Request & Response page. The fallback is for running the demo locally only.
app.set( "cookie secret", server.system.environment.COOKIE_SECRET ?: "dev-only-secret" )

// See "Timeouts and size limits" on the Configuration page.
app.set( "etag", "weak" )              // tag send()/json() bodies; a matching If-None-Match gets a 304
app.set( "requestTimeoutMs", 30000 )   // a handler has 30s to start responding
app.set( "maxBodySize", 12582912 )     // 12MB, a little over boxExpressUpload()'s 10MB default

app.set( "reloadOnChange", true )
app.set("env", "development")

// Shared sidebar nav for every /docs/* page — see views/partials/_sidebar.bxm.
// Set once on app.locals rather than passed to every render() call below —
// see the "app.locals / res.locals" section on the Views & Templates page.
app.locals.navGroups = [
    {
        label: "Getting Started",
        items: [
            { label: "Getting Started", href: "/docs/getting-started" },
            { label: "Configuration", href: "/docs/config" }
        ]
    },
    {
        label: "Core Concepts",
        items: [
            { label: "Routing", href: "/docs/routing" },
            { label: "Middleware", href: "/docs/middleware" },
            { label: "Request & Response", href: "/docs/request-response" },
            { label: "Views & Templates", href: "/docs/views" }
        ]
    },
    {
        label: "Features",
        items: [
            { label: "Sessions", href: "/docs/sessions" },
            { label: "Static Files & Uploads", href: "/docs/static-files" },
            { label: "Error Handling", href: "/docs/errors" }
        ]
    },
    {
        label: "Operations",
        items: [
            { label: "Process Lifecycle", href: "/docs/lifecycle" },
            { label: "Observability", href: "/docs/observability" },
            { label: "Testing Your App", href: "/docs/testing" }
        ]
    }
]

app.get("/", ( req, res ) => {
    res.render( "home", { title: "Home", docsMode: false, currentPath: req.path } )
})

app.get( "/docs/getting-started", ( req, res ) => {
    res.render( "docs/getting-started", { title: "Getting Started", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/config", ( req, res ) => {
    res.render( "docs/config", { title: "Configuration", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/routing", ( req, res ) => {
    res.render( "docs/routing", { title: "Routing", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/middleware", ( req, res ) => {
    res.render( "docs/middleware", { title: "Middleware", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/observability", ( req, res ) => {
    res.render( "docs/observability", { title: "Observability", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/testing", ( req, res ) => {
    res.render( "docs/testing", { title: "Testing Your App", docsMode: true, currentPath: req.path } )
} )

// The Testing page's live example: build a tiny app in memory, inject a
// request into it, and report what came back — no port involved.
app.get( "/docs/testing/demo", ( req, res ) => {
    var demo = boxExpress()
    demo.get( "/hello/:name", ( req, res ) => res.json( { greeting: "hello, " & req.params.name } ) )

    var result = demo.inject( { url: "/hello/ada?shout=1" } )
    res.json( { statusCode: result.statusCode, contentType: result.header( "content-type" ), body: result.json() } )
} )

// The Routing page's live examples: a constrained param with a fallback,
// two params in one segment, and a named wildcard.
routePatterns = boxExpressRouter()
routePatterns.get( "/users/:id(\d+)", ( req, res ) => res.json( { matched: "/users/:id(\d+)", params: req.params } ) )
routePatterns.get( "/users/:name", ( req, res ) => res.json( { matched: "/users/:name", params: req.params } ) )
routePatterns.get( "/flights/:from-:to", ( req, res ) => res.json( { matched: "/flights/:from-:to", params: req.params } ) )
routePatterns.get( "/files/*rest", ( req, res ) => res.json( { matched: "/files/*rest", params: req.params } ) )
app.use( "/docs/routing/demo", routePatterns )

// The Configuration page's live example: a handler that would take 5s,
// cut off after 1s by its own req.setTimeout().
app.get( "/docs/config/demo/slow", ( req, res ) => {
    req.setTimeout( 1000 )
    sleep( 5000 )
    res.send( "you won't see this" )
} )

// The Request & Response page's live example: one URL, HTML or JSON
// depending on the Accept header. Mounted as a router so req.baseUrl has
// something to show.
negotiationDemo = boxExpressRouter()
negotiationDemo.get( "/negotiate", ( req, res ) => {
    var info = {
        accepts: req.accepts( "html", "json" ),
        language: req.acceptsLanguages( "en", "fr", "de" ),
        xhr: req.xhr,
        baseUrl: req.baseUrl,
        path: req.path,
        originalUrl: req.originalUrl
    }
    res.format( [
        html: () => res.send( "<pre>" & encodeForHTML( JSONSerialize( info ) ) & "</pre>" ),
        json: () => res.json( info )
    ] )
} )
negotiationDemo.get( "/signed-cookie", ( req, res ) => {
    var previous = req.signedCookies.demo_visits ?: 0
    var tampered = ( previous === false )
    var visits = tampered ? 1 : previous + 1
    res.cookie( "demo_visits", visits, { signed: true, path: "/docs/request-response/demo" } )
    res.json( { visits: visits, tampered: tampered } )
} )
// A repeated key arrives as an array; a key sent once stays a string.
negotiationDemo.get( "/tags", ( req, res ) => {
    var tags = req.query.tag ?: []
    if ( !isArray( tags ) ) {
        tags = [ tags ]
    }
    res.json( { query: req.query, tags: tags } )
} )
// The body never changes, so its ETag doesn't either: a second request
// carrying it in If-None-Match gets an empty 304.
negotiationDemo.get( "/etag", ( req, res ) => res.json( { message: "This body only crosses the wire once.", docs: "/docs/request-response" } ) )
app.use( "/docs/request-response/demo", negotiationDemo )

app.get( "/docs/request-response", ( req, res ) => {
    res.render( "docs/request-response", { title: "Request & Response", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/views", ( req, res ) => {
    res.render( "docs/views", { title: "Views & Templates", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/sessions", ( req, res ) => {
    res.render( "docs/sessions", { title: "Sessions", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/static-files", ( req, res ) => {
    res.render( "docs/static-files", { title: "Static Files & Uploads", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/errors", ( req, res ) => {
    res.render( "docs/errors", { title: "Error Handling", docsMode: true, currentPath: req.path } )
} )

app.get( "/docs/lifecycle", ( req, res ) => {
    res.render( "docs/lifecycle", { title: "Process Lifecycle", docsMode: true, currentPath: req.path } )
} )

app.get( "/upload", boxExpressCsrf(), ( req, res ) => {
    res.render( "upload", { title: "Upload Demo", docsMode: false, currentPath: req.path, csrfToken: req.csrfToken() } )
} )

app.post(
    "/upload",
    boxExpressRateLimit( { windowMs: 5 * 60000, max: 10 } ),
    boxExpressUpload( { dest: expandPath( "./uploads" ) } ),
    // After boxExpressUpload(), not before — this needs req.body._csrf,
    // which the multipart parser above is what populates it.
    boxExpressCsrf(),
    ( req, res ) => {
        res.render( "upload", {
            title: "Upload Demo",
            docsMode: false,
            currentPath: req.path,
            result: {
                note: req.body.note ?: "",
                files: req.files.file ?: []
            }
        } )
    }
)

// Themed 404 — must come after every real route, since it's an unconditional
// catch-all: whatever hasn't matched by the time dispatch reaches this falls
// through to it.
app.use( ( req, res ) => {
    res.status( 404 ).render( "error", {
        layout: false,    // error.bxm is a complete page of its own
        statusCode: 404,
        title: "Page Not Found",
        message: "The page you're looking for doesn't exist or has moved.",
        path: req.path,
        accent: "##2563eb",
        iconPath: "M11 17a6 6 0 1 0 0-12 6 6 0 0 0 0 12ZM21 21l-4.35-4.35"
    } )
} )

// Themed 500 — a 4-arg handler only runs when a route/middleware throws or
// calls next(err), same as the framework's own default error handler.
app.use( ( err, req, res, next ) => {
    var isDev = app.getSetting( "env" ) == "development"
    res.status( 500 ).render( "error", {
        layout: false,    // error.bxm is a complete page of its own
        statusCode: 500,
        title: "Something Went Wrong",
        message: isDev ? err.message : "An unexpected error occurred. Please try again.",
        path: "",
        accent: "##dc2626",
        iconPath: "M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"
    } )
} )

app.listen(3003, ( port ) => {
    println( "Server is running on port #port#" )
})
